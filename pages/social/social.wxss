/* 社交页面样式 */
.social-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 顶部导航 */
.social-nav {
  display: flex;
  background: white;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.nav-item.active {
  color: #07c160;
  font-weight: bold;
}

.nav-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #07c160;
  border-radius: 2rpx;
}

/* 动态流 */
.feed-list {
  padding: 20rpx;
}

.feed-item {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.feed-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.username {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.follow-btn {
  padding: 12rpx 24rpx;
  background: #07c160;
  color: white;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.feed-content {
  margin-bottom: 20rpx;
}

.feed-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  margin-bottom: 16rpx;
}

.feed-collection {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 4rpx solid #07c160;
}

.collection-preview {
  display: flex;
  align-items: center;
}

.preview-favicon {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.preview-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.preview-url {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.feed-actions {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  transition: background 0.3s;
}

.action-item:active {
  background: #f5f5f5;
}

.action-item.liked {
  color: #ff4d4f;
}

.action-icon {
  font-size: 28rpx;
}

.action-count, .action-text {
  font-size: 24rpx;
  color: #666;
}

/* 用户列表 */
.user-list {
  padding: 20rpx;
}

.user-item {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.user-info {
  flex: 1;
  margin-left: 20rpx;
}

.user-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.follow-status {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-text {
  font-size: 24rpx;
  color: #999;
}

.btn-follow {
  padding: 12rpx 24rpx;
  background: #07c160;
  color: white;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: none;
}

.btn-unfollow {
  padding: 12rpx 24rpx;
  background: #f8f8f8;
  color: #666;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: none;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  opacity: 0.3;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #ccc;
}

/* 发布按钮 */
.post-fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 48rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.4);
  z-index: 100;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  width: 600rpx;
  background: white;
  border-radius: 24rpx;
  transition: transform 0.3s;
}

.modal.show .modal-content {
  transform: translate(-50%, -50%) scale(1);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 40rpx;
}

.post-textarea {
  width: 100%;
  height: 200rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.post-options {
  border-top: 1rpx solid #f0f0f0;
  padding-top: 30rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.option-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.option-selected {
  font-size: 24rpx;
  color: #07c160;
}

.modal-footer {
  display: flex;
  padding: 0 40rpx 40rpx;
  gap: 20rpx;
}

.btn-secondary {
  flex: 1;
  height: 80rpx;
  background: #f8f8f8;
  color: #666;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn-primary {
  flex: 1;
  height: 80rpx;
  background: #07c160;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
}
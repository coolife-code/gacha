<!-- 社交页面 -->
<view class="social-page">
  <!-- 顶部导航 -->
  <view class="social-nav">
    <view 
      class="nav-item {{activeTab === 'feed' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-tab="feed"
    >动态</view>
    <view 
      class="nav-item {{activeTab === 'follow' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-tab="follow"
    >关注</view>
    <view 
      class="nav-item {{activeTab === 'fans' ? 'active' : ''}}"
      bindtap="onTabChange"
      data-tab="fans"
    >粉丝</view>
  </view>

  <!-- 动态流 -->
  <view class="feed-list" wx:if="{{activeTab === 'feed'}}">
    <view 
      class="feed-item"
      wx:for="{{feedList}}"
      wx:key="id"
    >
      <view class="feed-header">
        <image class="avatar" src="{{item.user.avatar}}" />
        <view class="user-info">
          <text class="username">{{item.user.name}}</text>
          <text class="time">{{item.time}}</text>
        </view>
        <view class="follow-btn" wx:if="{{!item.isFollowing}}" bindtap="onFollow" data-user="{{item.user}}">
          关注
        </view>
      </view>

      <view class="feed-content">
        <text class="feed-text">{{item.content}}</text>
        <view class="feed-collection" wx:if="{{item.collection}}" bindtap="onViewCollection" data-item="{{item.collection}}">
          <view class="collection-preview">
            <view class="preview-favicon">{{item.collection.title.substring(0, 1)}}</view>
            <view class="preview-info">
              <text class="preview-title">{{item.collection.title}}</text>
              <text class="preview-url">{{item.collection.url}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="feed-actions">
        <view class="action-item {{item.isLiked ? 'liked' : ''}}" bindtap="onLike" data-item="{{item}}">
          <text class="action-icon">{{item.isLiked ? '❤️' : '🤍'}}</text>
          <text class="action-count">{{item.likeCount}}</text>
        </view>
        <view class="action-item" bindtap="onComment" data-item="{{item}}">
          <text class="action-icon">💬</text>
          <text class="action-count">{{item.commentCount}}</text>
        </view>
        <view class="action-item" bindtap="onShare" data-item="{{item}}">
          <text class="action-icon">↗️</text>
          <text class="action-text">分享</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{feedList.length === 0}}">
      <view class="empty-icon">👥</view>
      <text class="empty-text">暂无动态</text>
      <text class="empty-desc">关注好友后可以看到他们的动态</text>
    </view>
  </view>

  <!-- 关注列表 -->
  <view class="user-list" wx:if="{{activeTab === 'follow'}}">
    <view 
      class="user-item"
      wx:for="{{followList}}"
      wx:key="id"
    >
      <image class="avatar" src="{{item.avatar}}" />
      <view class="user-info">
        <text class="username">{{item.name}}</text>
        <text class="user-desc">{{item.desc}}</text>
      </view>
      <view class="follow-status">
        <text class="status-text">已关注</text>
        <button class="btn-unfollow" bindtap="onUnfollow" data-user="{{item}}">取消</button>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{followList.length === 0}}">
      <view class="empty-icon">👤</view>
      <text class="empty-text">暂无关注</text>
      <text class="empty-desc">去发现更多有趣的人</text>
    </view>
  </view>

  <!-- 粉丝列表 -->
  <view class="user-list" wx:if="{{activeTab === 'fans'}}">
    <view 
      class="user-item"
      wx:for="{{fansList}}"
      wx:key="id"
    >
      <image class="avatar" src="{{item.avatar}}" />
      <view class="user-info">
        <text class="username">{{item.name}}</text>
        <text class="user-desc">{{item.desc}}</text>
      </view>
      <view class="follow-status">
        <button 
          class="{{item.isFollowing ? 'btn-unfollow' : 'btn-follow'}}"
          bindtap="{{item.isFollowing ? 'onUnfollow' : 'onFollow'}}"
          data-user="{{item}}"
        >
          {{item.isFollowing ? '已关注' : '关注'}}
        </button>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{fansList.length === 0}}">
      <view class="empty-icon">👥</view>
      <text class="empty-text">暂无粉丝</text>
      <text class="empty-desc">分享你的收藏吸引更多关注</text>
    </view>
  </view>

  <!-- 发布按钮 -->
  <view class="post-fab" bindtap="onPost" wx:if="{{activeTab === 'feed'}}">
    <text>+</text>
  </view>

  <!-- 发布弹窗 -->
  <view class="modal {{showPostModal ? 'show' : ''}}" catchtap="onHidePostModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">发布动态</text>
        <view class="modal-close" bindtap="onHidePostModal">×</view>
      </view>
      
      <view class="modal-body">
        <textarea 
          class="post-textarea"
          placeholder="分享你的想法..."
          maxlength="200"
          value="{{postContent}}"
          bindinput="onPostInput"
        ></textarea>
        <text class="char-count">{{postContent.length}}/200</text>
        
        <view class="post-options">
          <view class="option-item" bindtap="onSelectCollection">
            <text class="option-icon">📚</text>
            <text class="option-text">关联收藏</text>
            <text class="option-selected" wx:if="{{selectedCollection}}">{{selectedCollection.title}}</text>
          </view>
        </view>
      </view>
      
      <view class="modal-footer">
        <button class="btn-secondary" bindtap="onHidePostModal">取消</button>
        <button class="btn-primary" bindtap="onSubmitPost">发布</button>
      </view>
    </view>
  </view>
</view>
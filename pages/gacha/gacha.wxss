/* pages/gacha/gacha.wxss */

.gacha-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  position: relative;
  overflow: hidden;
}

/* 动态背景 */
.bg-animation {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}

.particle {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  animation: float 6s infinite linear;
}

@keyframes float {
  0% {
    transform: translateY(100vh) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateY(-100vh) rotate(360deg);
    opacity: 0;
  }
}

/* 扭蛋机主体 */
.gacha-machine {
  position: relative;
  z-index: 1;
  padding: 60rpx 40rpx 40rpx;
}

.machine-shell {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 40rpx;
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.machine-top {
  height: 300rpx;
  background: linear-gradient(180deg, #2d3748 0%, #4a5568 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.display-window {
  width: 200rpx;
  height: 200rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.capsule-container {
  transition: all 0.5s ease;
}

.capsule-container.shake {
  animation: shake 0.5s ease-in-out;
}

.capsule-container.drop {
  animation: drop 1s ease-out;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}

@keyframes drop {
  0% {
    transform: translateY(-100rpx);
    opacity: 0;
  }
  50% {
    transform: translateY(0);
    opacity: 1;
  }
  100% {
    transform: translateY(0);
  }
}

.capsule {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #ff6b6b, #ffa726);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.4);
  animation: glow 2s infinite alternate;
}

@keyframes glow {
  0% {
    box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.4);
  }
  100% {
    box-shadow: 0 8rpx 32rpx rgba(255, 107, 107, 0.8);
  }
}

.capsule-text {
  font-size: 24rpx;
  font-weight: bold;
  color: white;
}

.machine-bottom {
  height: 60rpx;
  background: #2d3748;
  position: relative;
}

.output-tray {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 20rpx;
  background: #4a5568;
  border-radius: 10rpx 10rpx 0 0;
}

/* 控制面板 */
.control-panel {
  margin-top: 40rpx;
  text-align: center;
}

.draw-btn {
  width: 100%;
  height: 100rpx;
  border: none;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.draw-btn.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.3);
}

.draw-btn.active:active {
  transform: scale(0.95);
}

.draw-btn.disabled {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.5);
}

.count-text {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 结果展示 */
.result-section {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.result-card {
  background: white;
  border-radius: 30rpx;
  padding: 40rpx;
  width: 100%;
  max-width: 600rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
}

.result-card.slide-in {
  animation: slideIn 0.3s ease-out;
}

@keyframes slideIn {
  0% {
    transform: translateY(100rpx);
    opacity: 0;
  }
  100% {
    transform: translateY(0);
    opacity: 1;
  }
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.result-content {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  gap: 30rpx;
}

.result-icon {
  flex-shrink: 0;
}

.favicon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
}

.result-info {
  flex: 1;
}

.result-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.result-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  margin-bottom: 15rpx;
  display: block;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.result-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  border: none;
  border-radius: 15rpx;
  font-size: 26rpx;
  font-weight: bold;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.action-btn.secondary {
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

/* 历史记录 */
.history-section {
  padding: 0 40rpx 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
}

.history-list {
  white-space: nowrap;
}

.history-item {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-right: 20rpx;
  min-width: 200rpx;
  backdrop-filter: blur(10rpx);
}

.item-favicon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  margin-right: 15rpx;
}

.item-title {
  font-size: 24rpx;
  color: white;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-history {
  text-align: center;
  padding: 60rpx 0;
}

.empty-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
}

/* 统计信息 */
.stats-section {
  padding: 0 40rpx 40rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-item {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  backdrop-filter: blur(10rpx);
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .gacha-machine {
    padding: 40rpx 20rpx 30rpx;
  }
  
  .history-section, .stats-section {
    padding: 0 20rpx 30rpx;
  }
  
  .result-content {
    flex-direction: column;
    text-align: center;
  }
  
  .result-actions {
    flex-direction: column;
  }
}
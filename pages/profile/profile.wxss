/* pages/profile/profile.wxss */

.profile-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
}

.gradient-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  z-index: 0;
}

.user-card {
  position: relative;
  z-index: 1;
  background: white;
  margin: 30rpx;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.1);
}

.avatar-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.avatar-wrapper {
  position: relative;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 5rpx 15rpx rgba(0,0,0,0.2);
}

.avatar-badge {
  position: absolute;
  bottom: -10rpx;
  right: -10rpx;
  background: linear-gradient(45deg, #ff6b6b, #ee5a24);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.user-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  background: rgba(102, 126, 234, 0.1);
  border: none;
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #667eea;
}

.btn-icon {
  font-size: 28rpx;
}

.user-info {
  text-align: center;
  margin-bottom: 40rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.bio {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.user-tags {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.user-tag {
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background: rgba(102, 126, 234, 0.05);
  border-radius: 15rpx;
  transition: all 0.3s ease;
}

.stat-item:active {
  transform: scale(0.95);
  background: rgba(102, 126, 234, 0.1);
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #667eea;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-top: 8rpx;
}

.stat-progress {
  margin-top: 15rpx;
}

.progress-bar {
  width: 100%;
  height: 6rpx;
  background: rgba(102, 126, 234, 0.2);
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 3rpx;
  transition: width 0.5s ease;
}

.tab-nav-card {
  background: white;
  margin: 0 30rpx 30rpx;
  border-radius: 20rpx;
  padding: 20rpx;
  display: flex;
  box-shadow: 0 5rpx 20rpx rgba(0,0,0,0.1);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 20rpx;
  border-radius: 15rpx;
  transition: all 0.3s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  transform: translateY(-5rpx);
  box-shadow: 0 5rpx 15rpx rgba(102, 126, 234, 0.3);
}

.tab-icon {
  font-size: 40rpx;
  display: block;
  margin-bottom: 10rpx;
}

.tab-text {
  font-size: 24rpx;
  font-weight: 500;
}

.collection-stats {
  background: white;
  margin: 0 30rpx 20rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 5rpx 20rpx rgba(0,0,0,0.1);
}

.stats-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.stats-actions {
  display: flex;
  gap: 20rpx;
}

.sort-btn, .filter-btn {
  background: rgba(102, 126, 234, 0.1);
  border: none;
  border-radius: 50rpx;
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #667eea;
}

.collections-grid {
  padding: 0 30rpx 30rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.collection-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 5rpx 20rpx rgba(0,0,0,0.1);
  transition: all 0.3s ease;
}

.collection-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.2);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.favicon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
}

.card-actions {
  display: flex;
  gap: 10rpx;
}

.card-btn {
  background: none;
  border: none;
  padding: 8rpx;
  border-radius: 50%;
}

.delete-btn {
  color: #ff6b6b;
}

.card-content {
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-url {
  font-size: 22rpx;
  color: #666;
  display: block;
  margin-bottom: 15rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.tag-more {
  color: #999;
  font-size: 20rpx;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-time {
  font-size: 20rpx;
  color: #999;
}

.card-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.rating-star {
  font-size: 20rpx;
}

.rating-value {
  font-size: 20rpx;
  color: #ffa500;
}

.empty-collection {
  text-align: center;
  padding: 100rpx 30rpx;
}

.empty-illustration {
  position: relative;
  margin-bottom: 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.7;
}

.empty-pulse {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 160rpx;
  height: 160rpx;
  border: 4rpx solid rgba(102, 126, 234, 0.3);
  border-radius: 50%;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.7; }
  100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
}

.empty-title {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.empty-action {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 48rpx;
  color: white;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.3);
}

.action-icon {
  font-size: 32rpx;
}
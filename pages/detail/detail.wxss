/* 详情页面样式 */
.detail-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 网站预览 */
.website-preview {
  background: white;
  border-radius: 0 0 24rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.preview-header {
  display: flex;
  align-items: center;
  padding: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.favicon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.favicon-text {
  color: white;
  font-size: 40rpx;
  font-weight: bold;
}

.website-info {
  flex: 1;
  min-width: 0;
}

.website-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.website-url {
  display: block;
  font-size: 26rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.btn-action {
  padding: 12rpx 24rpx;
  background: #f8f8f8;
  color: #666;
  border: none;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.btn-action.collected {
  background: #fff8e6;
  color: #faad14;
}

.btn-icon {
  font-size: 24rpx;
}

.btn-text {
  font-size: 22rpx;
}

/* 预览内容 */
.preview-content {
  height: 400rpx;
  position: relative;
}

.web-view {
  width: 100%;
  height: 100%;
}

.preview-placeholder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f9fa;
}

.placeholder-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.placeholder-text {
  font-size: 28rpx;
  color: #999;
}

/* 操作栏 */
.action-bar {
  display: flex;
  gap: 20rpx;
  padding: 0 20rpx 20rpx;
}

.btn-primary {
  flex: 2;
  height: 100rpx;
  background: #07c160;
  color: white;
  border: none;
  border-radius: 16rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-secondary {
  flex: 1;
  height: 100rpx;
  background: #f8f8f8;
  color: #666;
  border: none;
  border-radius: 16rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

/* 网站信息 */
.website-info-section {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
  margin: 0 20rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
}

/* 相关推荐 */
.recommend-section {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
  margin: 0 20rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
}

.recommend-list {
  white-space: nowrap;
}

.recommend-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 160rpx;
  margin-right: 30rpx;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  transition: transform 0.2s;
}

.recommend-item:active {
  transform: scale(0.95);
}

.recommend-favicon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.recommend-title {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  width: 600rpx;
  background: white;
  border-radius: 24rpx;
  transition: transform 0.3s;
}

.modal.show .modal-content {
  transform: translate(-50%, -50%) scale(1);
}

.qr-content {
  width: 500rpx;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 40rpx;
}

.share-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.share-option {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #f8f9fa;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.share-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.share-text {
  flex: 1;
  text-align: left;
}

.qr-code {
  text-align: center;
  margin-bottom: 30rpx;
}

.qr-placeholder {
  font-size: 200rpx;
  display: block;
  margin-bottom: 20rpx;
}

.qr-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.qr-url {
  display: block;
  font-size: 24rpx;
  color: #999;
  text-align: center;
  word-break: break-all;
}

.modal-footer {
  display: flex;
  padding: 0 40rpx 40rpx;
  gap: 20rpx;
}

.btn-secondary {
  flex: 1;
  height: 80rpx;
  background: #f8f8f8;
  color: #666;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn-primary {
  flex: 1;
  height: 80rpx;
  background: #07c160;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
}
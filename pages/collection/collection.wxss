/* 收藏管理页面样式 */
.collection-page {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx;
  background: white;
}

.search-input {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input input {
  flex: 1;
  height: 80rpx;
  padding: 0 80rpx 0 30rpx;
  background: #f8f8f8;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.search-icon {
  position: absolute;
  right: 30rpx;
  font-size: 32rpx;
  color: #999;
}

/* 标签筛选 */
.tag-filter {
  padding: 20rpx;
  background: white;
  white-space: nowrap;
}

.tag-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 20rpx;
  background: #f8f8f8;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.3s;
}

.tag-item.active {
  background: #07c160;
  color: white;
}

/* 收藏列表 */
.collection-list {
  padding: 20rpx;
}

.collection-item {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.1);
  transition: transform 0.2s;
}

.collection-item:active {
  transform: scale(0.98);
}

.item-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.favicon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.favicon-text {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.url {
  display: block;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tag-badge {
  padding: 6rpx 16rpx;
  background: #e8f4ff;
  color: #1890ff;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.more-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 32rpx;
  color: #999;
  transition: background 0.3s;
}

.more-btn:active {
  background: #f5f5f5;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.time {
  font-size: 24rpx;
  color: #ccc;
}

.action-buttons {
  display: flex;
  gap: 16rpx;
}

.btn-mini {
  padding: 8rpx 24rpx;
  background: #f8f8f8;
  color: #666;
  border-radius: 20rpx;
  font-size: 24rpx;
  border: none;
}

.btn-mini:active {
  background: #e8e8e8;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  opacity: 0.3;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #ccc;
  margin-bottom: 40rpx;
}

/* 添加按钮 */
.add-fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 48rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.4);
  z-index: 100;
  transition: transform 0.3s;
}

.add-fab:active {
  transform: scale(0.9);
}

/* 操作菜单 */
.action-sheet {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.action-sheet.show {
  opacity: 1;
  visibility: visible;
}

.action-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-radius: 24rpx 24rpx 0 0;
  padding: 20rpx 0;
  transform: translateY(100%);
  transition: transform 0.3s;
}

.action-sheet.show .action-content {
  transform: translateY(0);
}

.action-item {
  padding: 30rpx 40rpx;
  text-align: center;
  font-size: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.action-item.delete {
  color: #ff4d4f;
}

.action-item.cancel {
  border-bottom: none;
  margin-top: 20rpx;
  color: #666;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  width: 600rpx;
  background: white;
  border-radius: 24rpx;
  transition: transform 0.3s;
}

.modal.show .modal-content {
  transform: translate(-50%, -50%) scale(1);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  padding: 40rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-item input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.modal-footer {
  display: flex;
  padding: 0 40rpx 40rpx;
  gap: 20rpx;
}

.btn-secondary {
  flex: 1;
  height: 80rpx;
  background: #f8f8f8;
  color: #666;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.btn-primary {
  flex: 1;
  height: 80rpx;
  background: #07c160;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 按钮样式 */
.btn-primary {
  background: #07c160;
  color: white;
  border: none;
  border-radius: 8rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
}

.btn-primary:active {
  background: #06a854;
}